{
  "family": "family-tree-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::452131198108:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "family-tree-container",
      "image": "452131198108.dkr.ecr.eu-north-1.amazonaws.com/family-tree-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "GIN_MODE",
          "value": "release"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://familytree:FamilyTree2026SecurePass@family-tree-db.cpq44ymc6opn.eu-north-1.rds.amazonaws.com:5432/familytree"
        },
        {
          "name": "REDIS_URL",
          "value": "SET_VIA_AWS_CONSOLE"
        },
        {
          "name": "FIREBASE_CREDENTIALS",
          "value": "SET_VIA_AWS_CONSOLE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/family-tree",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}